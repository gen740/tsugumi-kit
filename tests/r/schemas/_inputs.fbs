attribute "tsugumi";

namespace inputs.rtest;

enum Unit : ubyte { Counts, Volts }
struct Position { coordinates:[int:2]; units:[Unit:2]; depth:[int:1]; }
table Number { value:double; unit:Unit; }
table Choice { name:string (required); }
union Selection { Choice, Alias:Choice, Description:string }
table Row {
  name:string (required);
  signed_value:long;
  unsigned_value:ulong;
  special:[double];
  single:[double];
  empty:[int];
  wide:[ulong];
  bytes:[ubyte];
  enabled:[bool];
  unit:[Unit];
  nullable:int = null;
  position:Position;
  selection:Selection;
}
table DataTable { rows:[Row] (required); }

namespace inputs.arrival.tsugumi.merge.t0;
table Temperature { value:double; }

namespace inputs.arrival.tsugumi.merge.t1;
table Reading { name:string (required); }

namespace inputs.arrival.tsugumi.merge;
table TemperatureBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t0.Temperature"); }
table ReadingBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t1.Reading"); }
union Arrival { TemperatureBox, ReadingBox }
table Merged { value:Arrival (id: 1); }

namespace inputs;
table Inputs {
  number:inputs.rtest.Number (id: 0);
  params:inputs.rtest.Number (id: 1);
  params_:inputs.rtest.Number (id: 2);
  table:inputs.rtest.DataTable (id: 3);
  file:string (id: 4, tsugumi: "path");
  directory:string (id: 5, tsugumi: "path");
  arrival:inputs.arrival.tsugumi.merge.Merged (id: 6);
}
root_type Inputs;
