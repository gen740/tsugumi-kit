namespace outputs.number;
table Number { value:ulong; }

namespace outputs.table;
enum Label:ubyte { Normal, Special }
struct Center { xy:[float:2]; }
table Text { value:string (required); }
union Choice { Note:Text, Coordinate:Center, String:string }
table Row {
  label:Label;
  center:Center (required);
  measure:double;
  bytes:[ubyte];
  maybe:short = null;
  choice:Choice;
}
table Table { rows:[Row] (required); }

namespace outputs.file;
table File { value:string (required); }

namespace outputs.forward;
table File { value:string (required); }

namespace outputs;
table Outputs {
  number:outputs.number.Number (required);
  table:outputs.table.Table (required);
  file:outputs.file.File;
  forward:outputs.forward.File;
}
root_type Outputs;
