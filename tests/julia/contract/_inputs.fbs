namespace inputs.number;
table Number { value:ulong; }

namespace inputs.table;
enum Label:ubyte { Normal, Special }
struct Center { xy:[float:2]; }
table Text { value:string (required); }
union Choice { Note:Text, Coordinate:Center, String:string }
table Row {
  label:Label;
  center:Center (required);
  measure:double;
  bytes:[ubyte];
  maybe:short = null;
  choice:Choice;
}
table Table { rows:[Row] (required); }

namespace inputs.file;
table File { value:string (required); }

namespace inputs;
table Inputs {
  number:inputs.number.Number (required);
  table:inputs.table.Table (required);
  file:inputs.file.File;
}
root_type Inputs;
