attribute "tsugumi";

namespace rust_inputs.number;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace rust_inputs.payload;
table Label { text:string (required); }
union Choice { Label }
table Payload { data:Choice; values:[long]; }

namespace rust_inputs.arrival.tsugumi.merge.t0.nested.t0;
table Temperature { value:double; }

namespace rust_inputs.arrival.tsugumi.merge.t0.nested.t1;
table Count { count:long; }

namespace rust_inputs.arrival.tsugumi.merge.t0.nested;
table TemperatureBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "rust_inputs.arrival.tsugumi.merge.t0.nested.t0.Temperature"); }
table CountBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "rust_inputs.arrival.tsugumi.merge.t0.nested.t1.Count"); }
union Arrival { TemperatureBox, CountBox }
table Merged { value:Arrival (id: 1); }

namespace rust_inputs.arrival.tsugumi.merge.t1;
table Reading { name:string (required); }

namespace rust_inputs.arrival.tsugumi.merge;
table MergedBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "rust_inputs.arrival.tsugumi.merge.t0.nested.Merged"); }
table ReadingBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "rust_inputs.arrival.tsugumi.merge.t1.Reading"); }
union Arrival { MergedBox, ReadingBox }
table Merged { value:Arrival (id: 1); }

namespace rust_inputs;
table Inputs {
  number:rust_inputs.number.Number (id: 0);
  payload:rust_inputs.payload.Payload (id: 1);
  file:string (id: 2, tsugumi: "path");
  directory:string (id: 3, tsugumi: "path");
  arrival:rust_inputs.arrival.tsugumi.merge.Merged (id: 4);
}
root_type Inputs;
