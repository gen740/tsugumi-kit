attribute "tsugumi";

namespace inputs.from;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace inputs.from_;
table Number { value:long; }

namespace inputs.table;
table Row { name:string (required); count:long; }
table Note { text:string (required); }
table Count { value:long; }
union Detail { Note, Count }
table Data { rows:[Row] (required); detail:Detail; }

namespace inputs.arrival.tsugumi.merge.t0;
table Temperature { value:double (id: 0); }

namespace inputs.arrival.tsugumi.merge.t1;
table Reading { name:string (id: 0, required); }

namespace inputs.arrival.tsugumi.merge;
table TemperatureBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t0.Temperature"); }
table ReadingBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t1.Reading"); }
union Arrival { TemperatureBox, ReadingBox }
table Merged { value:Arrival (id: 1); }

namespace inputs;
table Inputs {
  from:inputs.from.Number (id: 0);
  from_:inputs.from_.Number (id: 1);
  table:inputs.table.Data (id: 2);
  file:string (id: 3, tsugumi: "path");
  directory:string (id: 4, tsugumi: "path");
  arrival:inputs.arrival.tsugumi.merge.Merged (id: 5);
}
root_type Inputs;
