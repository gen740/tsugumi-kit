attribute "tsugumi";

namespace inputs.from;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace inputs.from_;
table Number { value:long; }

namespace inputs.table;
table Row { name:string (required); count:long; }
table Note { text:string (required); }
table Count { value:long; }
union Detail { Note, Count }
table Data { rows:[Row] (required); detail:Detail; }

namespace inputs.file;
table File { value:string (required); }

namespace inputs.directory;
table Directory { value:string (required); }

namespace inputs;
table Inputs {
  from:inputs.from.Number (required);
  from_:inputs.from_.Number (required);
  table:inputs.table.Data (required);
  file:inputs.file.File (tsugumi: "file");
  directory:inputs.directory.Directory (tsugumi: "directory");
}
root_type Inputs;
