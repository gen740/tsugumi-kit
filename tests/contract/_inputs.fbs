attribute "tsugumi";

namespace inputs.number;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace inputs.file;
table File { value:string (required); }

namespace inputs.directory;
table Directory { value:string (required); }

namespace inputs;
table Inputs {
  number:inputs.number.Number (required);
  file:inputs.file.File (tsugumi: "file");
  directory:inputs.directory.Directory (tsugumi: "directory");
}

root_type Inputs;
