include "tsugumi/artifact.fbs";
namespace outputs;
table Child { file:tsugumi.Artifact (required); }
union Choice { File:tsugumi.Artifact }
table Listing {
  nested:Child (required);
  files:[tsugumi.Artifact] (required);
  choice:Choice (required);
  value:long;
}
table Outputs {
  listing:Listing (required);
  optional_value:Child;
}
root_type Outputs;
