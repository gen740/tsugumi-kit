attribute "tsugumi";

namespace outputs.number;
table Number { value:long; }

namespace outputs.out;
table Label { value:string (required); }
table Count { value:int; }
union Value { Label, Count }
table Sample { name:string (required); value:Value; }

namespace outputs.file;
table File { value:string (required); }

namespace outputs.directory;
table Directory { value:string (required); }

namespace outputs;
table Outputs {
  number:outputs.number.Number;
  out:outputs.out.Sample;
  file:outputs.file.File (tsugumi: "file");
  directory:outputs.directory.Directory (tsugumi: "directory");
}
root_type Outputs;
