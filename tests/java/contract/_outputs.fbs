namespace outputs.number;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace outputs.data;
table Row { value:long; }
table Text { text:string; }
table Count { value:long; }
union Choice { Text, Count }
table Data {
  rows:[Row] (required);
  choice:Choice;
}

namespace outputs.file;
table File { value:string (required); }

namespace outputs.forwarded;
table File { value:string (required); }

namespace outputs.directory;
table Directory { value:string (required); }
