attribute "tsugumi";

namespace outputs.number;
table Value { value:long; }
table Nested { return:Value (required); }
union Choice { Nested, Text:string }
table Number {
  number:Value (required);
  children:[Nested];
  choice:Choice;
  choices:[Choice];
  required_choice:Choice (required);
}

namespace outputs.file;
table File { value:string (required); }

namespace outputs.directory;
table Directory { value:string (required); }

namespace outputs.concept;
table constexpr { value:int; }

namespace outputs;
table Outputs {
  number:outputs.number.Number;
  file:outputs.file.File (tsugumi: "file");
  directory:outputs.directory.Directory (tsugumi: "directory");
  switch:outputs.concept.constexpr;
}

root_type Outputs;
