attribute "tsugumi";

namespace rust_outputs.number;
table Number { value:long; }

namespace rust_outputs.summary;
table Label { text:string (required); }
union Choice { Label }
table Summary { data:Choice (required); values:[long]; }

namespace rust_outputs.file;
table File { value:string (required); }

namespace rust_outputs.directory;
table Directory { value:string (required); }

namespace rust_outputs._2d;
table Value { x:long; y:long; }

namespace rust_outputs.async;
table Value { data:rust_outputs.summary.Choice (required); }

namespace rust_outputs;
table Outputs {
  number:rust_outputs.number.Number (required);
  summary:rust_outputs.summary.Summary (required);
  copy:rust_outputs.file.File (tsugumi: "file");
  forwarded:rust_outputs.file.File (tsugumi: "file");
  forwarded_directory:rust_outputs.directory.Directory (tsugumi: "directory");
  _2d:rust_outputs._2d.Value;
  async:rust_outputs.async.Value;
}
root_type Outputs;
