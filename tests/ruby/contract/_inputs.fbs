attribute "tsugumi";

namespace inputs.number;
table Number { value:long; }

namespace inputs.rows;
enum Tone:ubyte { Default, Warm }
struct Position (force_align: 32) { point:[double:2]; }
table Word { text:string (required); }
table Count { value:int; }
union Choice { Word, Count }
table Row {
  label:string (required);
  magnitude:double;
  bytes:[ubyte];
  tone:Tone;
  optional:uint = null;
  position:Position (required);
  choice:Choice;
  history:[Choice];
  readings:[double];
}
table Rows { rows:[Row] (required); }

namespace inputs.file;
table File { value:string (required); }

namespace inputs;
table Inputs {
  number:inputs.number.Number (required);
  rows:inputs.rows.Rows (required);
  file:inputs.file.File (tsugumi: "file");
}
root_type Inputs;
