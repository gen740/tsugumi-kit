attribute "tsugumi";

namespace outputs.number;
table Number { value:ulong; }

namespace outputs.table;
enum Label:ubyte { Normal, Special }
struct Center { xy:[float:2]; }
table Text { value:string (required); }
union Choice { Note:Text, Coordinate:Center, String:string }
table Row {
  label:Label;
  center:Center (required);
  measure:double;
  bytes:[ubyte];
  maybe:short = null;
  choice:Choice;
}
table Table { rows:[Row] (required); }

namespace outputs.concept;
table constexpr { return:int; __value:int; }

namespace outputs.arrival.tsugumi.merge.t0;
table Temperature { value:double; }

namespace outputs.arrival.tsugumi.merge.t1;
table Reading { name:string (required); }

namespace outputs.arrival.tsugumi.merge;
table TemperatureBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "outputs.arrival.tsugumi.merge.t0.Temperature"); }
table ReadingBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "outputs.arrival.tsugumi.merge.t1.Reading"); }
union Arrival { TemperatureBox, ReadingBox }
table Merged { value:Arrival (id: 1); }

namespace outputs;
table Outputs {
  number:outputs.number.Number (id: 0, required);
  table:outputs.table.Table (id: 1, required);
  file:string (id: 2, tsugumi: "path");
  forward:string (id: 3, tsugumi: "path");
  directory:string (id: 4, tsugumi: "path");
  switch:outputs.concept.constexpr (id: 5, required);
  arrival:outputs.arrival.tsugumi.merge.Merged (id: 6);
}
root_type Outputs;
