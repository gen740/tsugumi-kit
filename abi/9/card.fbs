// ABI 9. Source: gen740/Tsugumi e9f12cd36c262cf230209003de9aee8fcca30c56 (protocol/card.fbs).
// FlatBuffer payloads of the ABI 9 Card entry point and display effect.
include "tsugumi_enums.fbs";

namespace Tsugumi.Card;

table CardPort {
  name:string (id: 0, required);
  kind:Tsugumi.Data.PortKind (id: 1);
  // A FlatBuffer of the port's declared type, including File and Directory.
  bytes:[ubyte] (id: 2);
}

table CardInput {
  inputs:[CardPort] (id: 0);
  // A FlatBuffer of the generated parameters.Params table.
  params:[ubyte] (id: 1);
}

table CardFailure {
  kind:Tsugumi.Data.FailureKind (id: 0);
  message:string (id: 1);
  // Optional Card-definition-relative source and one-based line.
  source:string (id: 2);
  line:uint32 (id: 3);
  cell:string (id: 4);
}

table CardResult {
  outputs:[CardPort] (id: 0);
  failure:CardFailure (id: 1);
}

table CardDisplayBlob {
  name:string (id: 0, required);
  bytes:[ubyte] (id: 1);
}

table CardDisplay {
  module:string (id: 0, required);
  // The named module defines this content. The ABI only carries it.
  config:string (id: 1, required);
  blobs:[CardDisplayBlob] (id: 2);
}
