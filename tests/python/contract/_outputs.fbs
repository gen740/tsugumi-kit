attribute "tsugumi";

namespace outputs.number;
table Number { value:long; }

namespace outputs.table;
table Row { name:string (required); count:long; }
table Note { text:string (required); }
table Count { value:long; }
union Detail { Note, Count }
table Data { rows:[Row] (required); detail:Detail; }

namespace outputs.file;
table File { value:string (required); }

namespace outputs;
table Outputs {
  number:outputs.number.Number (required);
  table:outputs.table.Data (required);
  file:outputs.file.File (required, tsugumi: "file");
}
root_type Outputs;
