attribute "tsugumi";
namespace inputs.rows;
enum Tone:ubyte { Default, Warm, delete }
struct Position (force_align: 32) { point:[double:2]; flags:[bool:4]; }
table Node { value:int; children:[Node]; }
table Word { text:string (required); }
table Count { value:int; default:int; _hidden:int; }
union Choice { Word, Count }
table Row {
  label:string (required);
  magnitude:double;
  bytes:[ubyte];
  tone:Tone;
  optional:uint = null;
  position:Position (required);
  choice:Choice;
  history:[Choice];
  readings:[double];
  tree:Node;
  center:Position;
}
table Rows { rows:[Row] (required); }

namespace inputs;
table Inputs {
  rows:inputs.rows.Rows (id: 0);
}
root_type Inputs;
