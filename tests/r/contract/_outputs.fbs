include "_inputs.fbs";
attribute "tsugumi";

namespace outputs;
table Outputs {
  number:rtest.Number (required);
  table:rtest.DataTable (required);
  file:rtest.File (tsugumi: "file");
  forwarded:rtest.File (tsugumi: "file");
  directory:rtest.Directory (tsugumi: "directory");
}
root_type Outputs;
