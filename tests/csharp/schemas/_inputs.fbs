attribute "tsugumi";

namespace inputs.number;
struct Position (force_align: 32) { x:long; y:long; }
table Number { position:Position (required); }

namespace inputs.sample;
table Label { value:string (required); }
table Count { value:int; detail:string; }
union Value { Label, Count }
table Sample { name:string (required); value:Value; }

namespace inputs.arrival.tsugumi.merge.t0;
table Temperature { value:double; }

namespace inputs.arrival.tsugumi.merge.t1;
table Reading { name:string (required); }

namespace inputs.arrival.tsugumi.merge;
table TemperatureBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t0.Temperature"); }
table ReadingBox { bytes:[ubyte] (id: 0, nested_flatbuffer: "inputs.arrival.tsugumi.merge.t1.Reading"); }
union Arrival { TemperatureBox, ReadingBox }
table Merged { value:Arrival (id: 1); }

namespace inputs;
table Inputs {
  number:inputs.number.Number (id: 0);
  sample:inputs.sample.Sample (id: 1);
  file:string (id: 2, tsugumi: "path");
  directory:string (id: 3, tsugumi: "path");
  arrival:inputs.arrival.tsugumi.merge.Merged (id: 4);
}
root_type Inputs;
